# Axon Runtime Configuration (copy to .env)
AXON_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
AXON_TORCH_DTYPE=bfloat16
AXON_DEVICE=cuda
AXON_DEFAULT_LAYER=14

# Infrastructure (Docker Compose local defaults)
AXON_POSTGRES_DSN=postgresql://axon:axon@localhost:5432/axon
AXON_REDIS_URL=redis://localhost:6379/0
